# NutriPlan Environment Variables Example
# Copy this file to .env and configure your variables

# JWT Secret Key (generate a random 32+ character hex string for production)
JWT_SECRET=your_jwt_secret_key_here

# Token Time-to-Live in hours (default: 168 = 7 days)
JWT_TTL_HOURS=168

# Optional Database URL (defaults to SQLite in database/nutriplan.db)
# DATABASE_URL=sqlite:///database/nutriplan.db
# DATABASE_URL=postgresql://user:password@localhost:5432/nutriplan

# Default Admin & Demo Account Credentials for initial database seed
ADMIN_EMAIL=admin@nutriplan.app
ADMIN_PASSWORD=Admin@123
DEMO_EMAIL=demo@nutriplan.app
DEMO_PASSWORD=Demo@123

# Server Port
PORT=8000
